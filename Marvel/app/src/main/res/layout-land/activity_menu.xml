<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1720">

    <ImageView
        android:id="@+id/menu_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/menu_backdrop_landscape_1024x576" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/menu_safe_zone_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.59" />

        <LinearLayout
            android:id="@+id/menu_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/menu_panel_frame"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/menu_safe_zone_start"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/menu_evidence_marks"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#44CFBD" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="4dp"
                    android:background="#F2B84B" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="4dp"
                    android:background="#E4675D" />
            </LinearLayout>

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="@string/menu_title"
                android:textColor="#C4D5C8"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="@string/menu_tag"
                android:textColor="#44CFBD"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#52666A" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/menu_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/menu_primary_selector"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:fontFamily="monospace"
                android:minHeight="48dp"
                android:nextFocusDown="@id/menu_how_to_play"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/menu_start"
                android:textAllCaps="false"
                android:textColor="#C4D5C8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/menu_how_to_play"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/menu_secondary_selector"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:fontFamily="monospace"
                android:minHeight="48dp"
                android:nextFocusDown="@id/menu_credits"
                android:text="@string/menu_how_to_play_title"
                android:textAllCaps="false"
                android:textColor="#C4D5C8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/menu_credits"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/menu_secondary_selector"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:fontFamily="monospace"
                android:minHeight="48dp"
                android:nextFocusUp="@id/menu_how_to_play"
                android:text="@string/menu_credits_title"
                android:textAllCaps="false"
                android:textColor="#C4D5C8"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
