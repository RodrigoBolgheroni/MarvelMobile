<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/interview_turn_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/interview_turn_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/interview_turn_marker"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/interview_turn_marker_selector" />

        <LinearLayout
            android:id="@+id/interview_turn_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/interview_bubble_character"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/interview_turn_speaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxWidth="320dp"
                android:textColor="#44CFBD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/interview_turn_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:maxWidth="320dp"
                android:textColor="#C4D5C8"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
