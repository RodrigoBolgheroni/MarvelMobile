<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/interview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/interview_dialog_frame"
    android:descendantFocusability="afterDescendants"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/interview_identity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/interview_portrait"
            android:layout_width="64dp"
            android:layout_height="96dp"
            android:background="@drawable/interview_portrait_frame"
            android:contentDescription="@string/interview_portrait_description"
            android:padding="1dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/interview_scene_tag"
                android:textColor="#44CFBD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/interview_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="#C4D5C8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/interview_personality_tag"
                android:textColor="#F2B84B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/interview_personality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#C4D5C8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/interview_notebook"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/hotbar_notebook_selector"
            android:contentDescription="@string/case_notebook_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/interview_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hotbar_notebook" />

        <Button
            android:id="@+id/interview_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/profile_button_selector"
            android:backgroundTint="@null"
            android:contentDescription="@string/comic_vine_open_profile"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/interview_close"
            android:text="@string/comic_vine_profile_short"
            android:textAllCaps="false"
            android:textColor="@color/profile_button_text"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <ImageButton
            android:id="@+id/interview_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/hotbar_clue_selector"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/interview_input"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_interview_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#44CFBD" />

    <TextView
        android:id="@+id/interview_transcript_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:text="@string/interview_transcript_title"
        android:textColor="#44CFBD"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/interview_transcript_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D1720"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:minHeight="48dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/interview_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/interview_transcript_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/chat_empty"
                android:textColor="#C4D5C8"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/interview_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/interview_status_frame"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/interview_status_marker"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/interview_status_marker_selector"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/interview_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#F2B84B"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/interview_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/interview_input_frame"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:minHeight="48dp"
            android:minWidth="88dp"
            android:nextFocusForward="@id/interview_send"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#C4D5C8"
            android:textColorHint="#718AA3"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/interview_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/hotbar_clue_selector"
            android:contentDescription="@string/interview_ask"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/interview_retry"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_interview_send" />

        <Button
            android:id="@+id/interview_retry"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/interview_retry_selector"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/interview_close"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="#0D1720"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
