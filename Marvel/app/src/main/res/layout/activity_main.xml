<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08131B">

    <LinearLayout
        android:id="@+id/room_header"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="#101F29"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_title"
            android:textColor="#72E8DC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/room_case_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:textColor="#F4FAF8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_new_case"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/new_case"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/room_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/room_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/room_header">

        <FrameLayout
            android:id="@+id/room_stage_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/room_background"
            android:contentDescription="@string/room_board_description" />

        <LinearLayout
            android:id="@+id/room_panel"
            android:layout_width="278dp"
            android:layout_height="match_parent"
            android:background="#12232E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/case_briefing"
                android:textColor="#72E8DC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/room_instructions"
                android:textColor="#D6E0E5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/room_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#0B1720"
                android:padding="8dp"
                android:textColor="#F2BD58"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/evidence_board"
                android:textColor="#72E8DC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/room_clue_summary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="top"
                android:maxLines="12"
                android:scrollbars="vertical"
                android:textColor="#D6E0E5"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_notebook"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/case_notebook"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_accuse"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/accuse"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/room_footer"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="#101F29"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="@string/room_footer"
        android:textColor="#96ABB5"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
