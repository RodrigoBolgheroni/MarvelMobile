<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1720">

    <FrameLayout
        android:id="@+id/room_stage_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0D1720"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintBottom_toTopOf="@id/room_hotbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.projetos.marvel.ui.room.RoomCanvasView
            android:id="@+id/room_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/room_board_description"
            android:focusable="true" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/room_hotbar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#243543"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_notebook"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/hotbar_notebook_selector"
            android:contentDescription="@string/case_notebook_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hotbar_notebook" />

        <HorizontalScrollView
            android:id="@+id/investigation_clues_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <LinearLayout
                    android:id="@+id/hotbar_clue_slots"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btn_accusation_slot"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/hotbar_accusation_selector"
            android:contentDescription="@string/hotbar_loupe_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hotbar_accusation" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
